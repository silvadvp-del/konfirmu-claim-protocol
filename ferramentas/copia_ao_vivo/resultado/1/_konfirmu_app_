<script>// Decode the RFC 1924 alphabet used by Python b85encode. ':' stands for '<' in HTML.
function base85bytes(text) {
  const alphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&()*+-;:=>?@^_`{|}~";
  const parts = [], chunk = [];
  for (let pos = 0; pos < text.length; pos += 5) {
    const count = Math.min(5, text.length-pos);
    if (count === 1) throw Error('Base85 incompleta');
    let value = 0;
    for (let j = 0; j < 5; j++) {
      const digit = j < count ? alphabet.indexOf(text[pos+j]) : 84;
      if (digit < 0) throw Error('Base85 inválida');
      value = value*85+digit;
    }
    if (value > 0xffffffff) throw Error('Base85 inválida');
    for (let n = 0; n < count-1; n++) chunk.push((value >>> (24-n*8)) & 255);
    if (chunk.length >= 4096) {parts.push(String.fromCharCode.apply(null,chunk));chunk.length=0;}
  }
  parts.push(String.fromCharCode.apply(null,chunk));
  return parts.join('');
}
